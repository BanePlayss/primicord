<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita as projecoes WinRT — Windows.Graphics.Capture (tela, Fase 2).
         Mesmo TFM do CherrySpy, entao o que for portado de la compila sem ajuste. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Primicord</AssemblyName>
    <RootNamespace>Primicord</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SpeexDSPSharp" Version="1.3.0" />
  </ItemGroup>

</Project>
