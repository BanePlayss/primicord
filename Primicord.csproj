<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita as projecoes WinRT — Windows.Graphics.Capture (tela, Fase 2).
         Mesmo TFM do CherrySpy, entao o que for portado de la compila sem ajuste. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Primicord</AssemblyName>
    <RootNamespace>Primicord</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Primicord.ico</ApplicationIcon>
    <!-- Trimming quebra reflection do WinForms/NAudio — deixar desligado. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- unsafe: copia linha a linha da memoria mapeada da GPU (DxgiCapture). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- As flags de self-contained/single-file NAO ficam aqui: elas contaminam o
         build normal e impedem que outro projeto referencie este (NETSDK1151, que
         quebrou o harness de teste). Vao como argumentos do publish, no build.ps1. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Include="Assets\primitivao-reference.png" LogicalName="Primicord.Brand" />
    <EmbeddedResource Include="Assets\camp-banner.png" LogicalName="Primicord.Camp" />
    <!-- Motor de video empacotado pelo build.ps1 (ver VlcRuntime.cs). Sem ele o app
         compila e roda normal; so a sessao cinema fica indisponivel. -->
    <EmbeddedResource Include="vlc-runtime.zip" Condition="Exists('vlc-runtime.zip')"
                      LogicalName="vlc-runtime.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SpeexDSPSharp" Version="1.3.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
