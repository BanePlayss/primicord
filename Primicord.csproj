<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita as projecoes WinRT — Windows.Graphics.Capture (tela, Fase 2).
         Mesmo TFM do CherrySpy, entao o que for portado de la compila sem ajuste. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Primicord</AssemblyName>
    <RootNamespace>Primicord</RootNamespace>
    <!-- E ESTE numero que o botao de atualizar compara com a tag da release do
         GitHub. Subir aqui e publicar a release sao o mesmo ato: se o exe sair com
         a versao antiga, todo mundo vai baixar de novo o que ja tem. -->
    <Version>0.6.0</Version>
    <ApplicationIcon>Primicord.ico</ApplicationIcon>
    <!-- Trimming quebra reflection do WinForms/NAudio — deixar desligado. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- unsafe: copia linha a linha da memoria mapeada da GPU (DxgiCapture). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- O pacote do VLC copia libvlc\win-x64, win-x86 E win-arm64 pro output quando
         Platform=AnyCPU, e o IncludeNativeLibrariesForSelfExtract enfia as TRES
         dentro do exe: 227MB, sendo ~135MB de peso morto. O app nunca usa essa
         copia — ele extrai o vlc-runtime.zip curado pra %APPDATA% (VlcRuntime.cs),
         que ja esta embutido como recurso. O build.ps1 monta esse zip a partir do
         pacote NuGet, entao nada aqui depende do output. -->
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <!-- As flags de self-contained/single-file NAO ficam aqui: elas contaminam o
         build normal e impedem que outro projeto referencie este (NETSDK1151, que
         quebrou o harness de teste). Vao como argumentos do publish, no build.ps1. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- O glob padrao do SDK e **/*.cs a partir da pasta do csproj, entao SEM isto
         o projeto do app compila os arquivos de tests/ junto e quebra com CS0246
         em cima de Fact/Theory (xunit nao e referencia daqui). Vale pro obj/bin do
         projeto de teste tambem, que mora sob tests/. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opus. Ja vem como dependencia do SIPSorcery, mas usamos os tipos direto
         (encoder com DTX/FEC configurados), entao a referencia e explicita. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Camera. P/Invoke puro, sem binario nativo junto — nao engorda o exe. -->
    <PackageReference Include="FlashCap" Version="1.11.0" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- WebRTC (RTCPeerConnection, ICE, DTLS-SRTP) — ver WebRtcVoice.cs. -->
    <PackageReference Include="SIPSorcery" Version="10.0.15" />
    <PackageReference Include="SpeexDSPSharp" Version="1.3.0" />
    <!-- Instalador + atualizacao diferencial. Ver Updater.cs pro porque. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
